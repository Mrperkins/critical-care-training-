{
  "name": "physio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node --import tsx scripts/build-app.ts",
    "site": "node --import tsx scripts/audio-voice-lines.ts && node --import tsx scripts/audio-production-queue.ts && node --import tsx scripts/audio-completion-audit.ts && node --import tsx scripts/label-index.ts && node --import tsx scripts/review-packet.ts && node --import tsx scripts/build-app.ts && node scripts/copy-site.mjs",
    "asset:body": "node --import tsx pipeline/build-body.ts",
    "asset:resp": "node --import tsx pipeline/build-resp.ts",
    "asset:micro": "node --import tsx pipeline/build-micro.ts",
    "asset:lines": "node --import tsx pipeline/build-lines.ts",
    "asset:skeleton": "node --import tsx pipeline/build-skeleton.ts",
    "asset:pericardium": "node --import tsx pipeline/build-pericardium.ts",
    "asset:neuro": "node --import tsx pipeline/build-neuro.ts",
    "asset:heart-internals": "node --import tsx pipeline/build-heart-internals.ts",
    "asset:heart-hd": "node --import tsx pipeline/build-heart-hd.ts",
    "asset:heart": "node --import tsx pipeline/build-heart-internals.ts && node --import tsx pipeline/build-heart-hd.ts && node --import tsx pipeline/build-heart-internals.ts",
    "asset:optimize": "node --import tsx pipeline/optimize-assets.ts",
    "asset:upper-airway": "node --import tsx pipeline/build-upper-airway.ts",
    "asset:coronary": "node --import tsx pipeline/build-coronary.ts && node --import tsx pipeline/validate-coronary.ts",
    "audio:lines": "node --import tsx scripts/audio-voice-lines.ts",
    "audio:voice:validate": "python3 scripts/audio_voice_validate.py",
    "audio:review": "node --import tsx scripts/audio-review-packet.ts",
    "audio:production": "node --import tsx scripts/audio-production-queue.ts && node --import tsx scripts/audio-render-plan.ts",
    "audio:audit": "node --import tsx scripts/audio-completion-audit.ts",
    "audio:render-plan": "node --import tsx scripts/audio-render-plan.ts",
    "video:discover": "node --import tsx scripts/youtube-discovery.ts",
    "asset:nerves": "node --max-old-space-size=12000 --import tsx pipeline/build-nerves.ts",
    "asset:gut": "node --max-old-space-size=12000 --import tsx pipeline/build-gut.ts",
    "asset:cerebral": "node --max-old-space-size=14000 --import tsx pipeline/build-cerebral.ts",
    "asset:brain-volume": "node --max-old-space-size=12000 --import tsx pipeline/build-brain-volume.ts",
    "asset:rep-stills": "node --max-old-space-size=12000 --import tsx pipeline/build-rep-stills.ts"
  },
  "dependencies": {
    "@react-three/drei": "9.99.7",
    "@react-three/fiber": "8.15.19",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "zustand": "4.5.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.0.8",
    "@gltf-transform/extensions": "^4.0.8",
    "@gltf-transform/functions": "^4.0.8",
    "@playwright/test": "1.56.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.160.0",
    "esbuild": "0.20.2",
    "jsdom": "^24.1.3",
    "meshoptimizer": "^0.21.0",
    "sharp": "^0.34.5",
    "three-mesh-bvh": "^0.7.5",
    "tsx": "4.10.5",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  }
}
